# REQUIRED: AI API keys for music generation
OPENAI_API_KEY=your_openai_api_key_here
SUNO_API_KEY=your_suno_api_key_here

# Google Authentication (OAuth)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# NextAuth.js Configuration
NEXTAUTH_SECRET=your_nextauth_secret_key_here
NEXTAUTH_URL=http://localhost:3000

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/love_album_db

# Shopify Integration (Storefront API - Custom Store)
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_storefront_access_token_here
SHOPIFY_WEBHOOK_SECRET=your_webhook_secret_here
SHOPIFY_PRODUCT_VARIANT_ID=your_product_variant_id_here

# Email Service (Resend)
RESEND_API_KEY=re_JMokMSxp_ngWEpwfhxgkmWbQq7w3M87ho
EMAIL_FROM=AI Love Album <noreply@yourdomain.com>

# Application URL (for email links and webhooks)
NEXT_PUBLIC_APP_URL=https://yourdomain.com

# AWS S3 Storage (for permanent song storage)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_S3_BUCKET_NAME=your-bucket-name

# API Sources:
# - Suno API key: https://sunoapi.org/api-key
# - OpenAI API key: https://platform.openai.com/api-keys
# - Google OAuth: https://console.cloud.google.com/
# - Shopify Storefront Token: Your Shopify Admin > Apps > Develop apps > Create custom app > Storefront API
# - Resend API: https://resend.com/api-keys

# Setup Instructions:
# 1. Replace all placeholder values with actual credentials
# 2. Set up Google OAuth app and get client ID/secret
# 3. Generate a secure NextAuth secret: openssl rand -base64 32
# 4. Set up PostgreSQL database and update DATABASE_URL
# 5. Configure Shopify store and webhook endpoints
# 6. Set up Resend account and get API key
# 7. Update NEXT_PUBLIC_APP_URL to your production domain
# 8. Configure webhook endpoint in Shopify: https://yourdomain.com/api/shopify/webhook
# 9. Set up AWS S3 for permanent song storage:
#    a. Create an AWS account at https://aws.amazon.com/
#    b. Create an S3 bucket with public read access
#    c. Create an IAM user with S3 access
#    d. Add credentials to .env.local