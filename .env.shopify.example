# Shopify App Integration Environment Variables
# Copy this file to .env.local and fill in your actual values

# ============================================
# SHOPIFY CONFIGURATION
# ============================================

# Shopify App Credentials (from Partner Dashboard)
SHOPIFY_APP_NAME="AI Love Story Album Generator"
SHOPIFY_CLIENT_ID="your_shopify_client_id_here"
SHOPIFY_CLIENT_SECRET="your_shopify_client_secret_here"

# Shopify Store Configuration
SHOPIFY_STORE_URL="your-store.myshopify.com"
SHOPIFY_ACCESS_TOKEN="shpat_your_storefront_access_token"
SHOPIFY_PRODUCT_VARIANT_ID="your_product_variant_id"

# Shopify Webhook Secret (for signature verification)
SHOPIFY_WEBHOOK_SECRET="your_webhook_secret_here"

# ============================================
# EXISTING CONFIGURATION (keep these)
# ============================================

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/love_album"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your_nextauth_secret"

# Google OAuth
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# OpenAI API
OPENAI_API_KEY="sk-your_openai_key"

# Suno API (Music Generation)
SUNO_API_KEY="your_suno_api_key"
SUNO_API_BASE_URL="https://api.sunoapi.org/api/v1"

# Email (Resend)
RESEND_API_KEY="re_your_resend_key"

# ============================================
# SHOPIFY APP PROXY SETUP NOTES
# ============================================

# App Proxy Configuration:
# - In Shopify Partner Dashboard, configure App Proxy:
#   - Subpath: love-album
#   - Proxy URL: https://your-domain.com/api/shopify-proxy/widget
#
# This makes your app accessible at:
# https://merchant-store.com/apps/love-album

# For local development with ngrok:
# 1. Run: ngrok http 3000
# 2. Update NEXTAUTH_URL with ngrok URL
# 3. Update Shopify App Proxy URL in Partner Dashboard
# 4. Update shopify.app.toml with ngrok URL

# Production deployment:
# 1. Deploy to Vercel/your hosting
# 2. Update NEXTAUTH_URL with production domain
# 3. Update Shopify App Proxy URL to production domain
# 4. Update shopify.app.toml with production URL
