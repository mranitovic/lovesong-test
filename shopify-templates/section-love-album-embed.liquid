{% comment %}
  AI Love Album Generator - Section (Embeddable anywhere)

  This is a reusable section that can be added to any page via the theme editor.

  Setup:
  1. In Shopify Admin, go to: Online Store > Themes > Edit Code
  2. Create new section: Sections > Add a new section > name it "love-album-embed"
  3. Paste this code
  4. Add to any page via: Customize theme > Add section > "Love Album Embed"

  Replace YOUR_APP_DOMAIN with your actual domain
{% endcomment %}

<div class="love-album-section" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="section-header text-center">
        <h2 class="section-heading">{{ section.settings.heading }}</h2>
        {% if section.settings.description != blank %}
          <div class="section-description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="love-album-embed-wrapper">
      <iframe
        id="love-album-embed-{{ section.id }}"
        src="https://poc-songs-album.vercel.app/en?shop={{ shop.domain }}&section={{ section.id }}"
        width="100%"
        height="{{ section.settings.initial_height }}"
        frameborder="0"
        scrolling="no"
        style="border: none; overflow: hidden;"
        title="{{ section.settings.heading | default: 'Create Your Love Album' }}"
        loading="lazy"
      ></iframe>
    </div>
  </div>
</div>

<style>
  .love-album-section {
    background-color: {{ section.settings.background_color }};
  }

  .section-header {
    margin-bottom: 40px;
  }

  .section-heading {
    font-size: 32px;
    font-weight: bold;
    margin-bottom: 16px;
    color: {{ section.settings.heading_color }};
  }

  .section-description {
    font-size: 18px;
    color: {{ section.settings.text_color }};
    max-width: 700px;
    margin: 0 auto;
  }

  .love-album-embed-wrapper {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    {% if section.settings.add_shadow %}
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    {% endif %}
  }

  #love-album-embed-{{ section.id }} {
    display: block;
    width: 100%;
  }

  @media (max-width: 768px) {
    .section-heading {
      font-size: 24px;
    }

    .section-description {
      font-size: 16px;
    }

    .love-album-section {
      padding: {{ section.settings.padding_top | divided_by: 2 }}px 0 {{ section.settings.padding_bottom | divided_by: 2 }}px !important;
    }
  }
</style>

<script>
  (function() {
    const iframe = document.getElementById('love-album-embed-{{ section.id }}');

    // Auto-resize iframe based on content
    window.addEventListener('message', function(event) {
      // Verify origin for security
      if (event.origin !== 'https://poc-songs-album.vercel.app') {
        return;
      }

      if (event.data.type === 'resize' && event.data.height) {
        iframe.style.height = event.data.height + 'px';
      }
    });

    // Handle checkout redirect
    window.addEventListener('message', function(event) {
      if (event.origin !== 'https://poc-songs-album.vercel.app') {
        return;
      }

      if (event.data.type === 'CHECKOUT_READY' && event.data.checkoutUrl) {
        window.location.href = event.data.checkoutUrl;
      }
    });
  })();
</script>

{% schema %}
{
  "name": "Love Album Embed",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Section Heading",
      "default": "Create Your Personalized Love Story Album"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Share your unique love story and we'll create a custom album of AI-generated songs just for you.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum Width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "initial_height",
      "label": "Initial Height",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "checkbox",
      "id": "add_shadow",
      "label": "Add Shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#f8f9fa"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    }
  ],
  "presets": [
    {
      "name": "Love Album Embed"
    }
  ]
}
{% endschema %}
