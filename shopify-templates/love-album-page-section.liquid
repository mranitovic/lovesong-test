{% comment %}
  AI Love Album Generator - Page Section

  This section is used by the page.love-album.json template.
  It contains the full-page embed with customizable schema settings.

  Setup:
  1. In Shopify Admin, go to: Online Store > Themes > Edit Code
  2. Create new section: Sections > Add a new section > name it "love-album-page-section"
  3. Paste this code
  4. Then upload page.love-album.json as a new page template

  Replace YOUR_APP_DOMAIN with your actual domain
{% endcomment %}

<div class="love-album-page" style="padding: {{ section.settings.padding_top }}px 0 {{ section.settings.padding_bottom }}px;">
  <div class="page-width">
    {% if section.settings.heading != blank %}
      <div class="page-header text-center">
        <h1 class="page-heading">{{ section.settings.heading }}</h1>
        {% if section.settings.description != blank %}
          <div class="page-description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </div>
    {% endif %}

    <div class="love-album-embed-container">
      <iframe
        id="love-album-iframe"
        src="https://poc-songs-album.vercel.app/en?shop={{ shop.domain }}"
        width="100%"
        height="{{ section.settings.initial_height }}"
        frameborder="0"
        scrolling="auto"
        style="border: none;"
        title="{{ section.settings.heading | default: 'Create Your Love Album' }}"
      ></iframe>
    </div>
  </div>
</div>

<style>
  .love-album-page {
    background-color: {{ section.settings.background_color }};
  }

  .page-header {
    margin-bottom: 40px;
  }

  .page-heading {
    font-size: 40px;
    font-weight: bold;
    margin-bottom: 20px;
    color: {{ section.settings.heading_color }};
  }

  .page-description {
    font-size: 18px;
    color: {{ section.settings.text_color }};
    max-width: 700px;
    margin: 0 auto;
  }

  .love-album-embed-container {
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
    {% if section.settings.add_shadow %}
    background: #fff;
    border-radius: 8px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    overflow: hidden;
    {% endif %}
  }

  #love-album-iframe {
    display: block;
    width: 100%;
  }

  @media (max-width: 768px) {
    .love-album-page {
      padding: {{ section.settings.padding_top | divided_by: 2 }}px 0 {{ section.settings.padding_bottom | divided_by: 2 }}px !important;
    }

    .page-heading {
      font-size: 28px;
    }

    .page-description {
      font-size: 16px;
    }
  }
</style>

<script>
  // Auto-resize iframe based on content
  window.addEventListener('message', function(event) {
    // Verify origin for security
    if (event.origin !== 'https://poc-songs-album.vercel.app') {
      return;
    }

    const iframe = document.getElementById('love-album-iframe');

    if (event.data.type === 'resize' && event.data.height) {
      iframe.style.height = event.data.height + 'px';
    }
  });

  // Handle successful submission
  window.addEventListener('message', function(event) {
    if (event.origin !== 'https://poc-songs-album.vercel.app') {
      return;
    }

    if (event.data.type === 'CHECKOUT_READY') {
      // Redirect to Shopify checkout
      window.location.href = event.data.checkoutUrl;
    }
  });
</script>

{% schema %}
{
  "name": "Love Album Page",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Page Heading",
      "default": "Create Your Love Story Album"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Page Description",
      "default": "<p>Share your love story and we'll create a personalized album just for you.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "label": "Maximum Width",
      "min": 600,
      "max": 1400,
      "step": 50,
      "unit": "px",
      "default": 1200
    },
    {
      "type": "range",
      "id": "initial_height",
      "label": "Initial Height",
      "min": 400,
      "max": 1200,
      "step": 50,
      "unit": "px",
      "default": 800
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom Padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "add_shadow",
      "label": "Add Shadow",
      "default": true
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background Color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading Color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#666666"
    }
  ]
}
{% endschema %}
